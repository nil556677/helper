# ---------- 运行期数据：内容不进版本控制，目录靠 .gitkeep 保留 ----------
# 备份 = 复制 data/ 整个目录；模型文件太大（1.09 GB），下载与量化说明都在 README.md 里
/data/*
!/data/.gitkeep
/models/*
!/models/.gitkeep
/logs/*
!/logs/.gitkeep

# ---------- 第三方二进制（不入库，用下载脚本获取） ----------
/bin/qdrant/qdrant.exe
/bin/qdrant/.qdrant-initialized
/bin/qdrant/static/
/bin/qdrant/snapshots/
/bin/qdrant/*.zip

# ---------- 可再生缓存（别进版本库） ----------
# jieba 的分词前缀词典缓存：首次运行自动生成（约 9 MB），换机器/删掉都会自己重建
jieba.cache

# ---------- 本机配置 ----------
# config.json 只放引导项（日志级别、数据目录）；api key 加密后存在数据库里，不属于这个文件
/config.json
/config.bad-*.json
/config.migrated-*.json

# ---------- 运行/诊断残留（不允许进版本库） ----------
/debug.log
/app/debug.log
/.qdrant-initialized
/snapshots/

# ---------- 内部文档：整个 docs/ 不进版本控制（按用户要求） ----------
# 技术方案、开发计划、命名规范都只在本机维护；clone 到别的机器不会带上 docs/ 下的任何文件
/docs/


# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---------- 测试与工具缓存：**所有临时产物一律放仓库内 .tmp/**（见技术方案 §4） ----------
# 这是硬规矩：不要在仓库根留任何中间文件、探针脚本、下载产物。.tmp/ 整个被忽略，随便堆。
/.tmp/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- 打包产物（打包暂缓，先把忽略项占住） ----------
/packaging/build/
/packaging/output/
/packaging/dist/

# ---------- IDE / 系统 ----------
.idea/
.vscode/
Thumbs.db
desktop.ini
AGENTS.md
CHANGELOG.md
debug.log
